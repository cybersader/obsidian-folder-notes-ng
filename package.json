{
	"name": "folder-notes",
	"version": "1.0.1",
	"description": "Adds Folder Notes to the default file tree.",
	"main": "main.js",
	"scripts": {
		"fn-dev": "node esbuild.config.mjs",
		"dev": "npm run fn-dev",
		"fn-build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"e2e": "wdio run wdio.conf.mts",
		"test:unit": "bun test tests/unit",
		"fv-build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs --overview production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"folder-overview": "node esbuild.config.mjs --overview",
		"fv-dev": "npm run folder-overview",
		"lint": "eslint --max-warnings=0 \"src/**/*.ts\" package.json manifest.json LICENSE",
		"build": "npm run fn-build",
		"check:privacy": "python3 scripts/check-public-tree.py"
	},
	"keywords": [],
	"author": "Lost Paul",
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"@wdio/cli": "^9.28.0",
		"@wdio/local-runner": "^9.28.0",
		"@wdio/mocha-framework": "^9.28.0",
		"esbuild": "0.14.47",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.6.0",
		"expect": "^29.7.0",
		"front-matter-plugin-api-provider": "^0.1.4-alpha",
		"globals": "^16.3.0",
		"jiti": "^2.5.1",
		"obsidian": "latest",
		"obsidian-typings": "^2.2.0",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.38.0",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.6"
	}
}
